# Base de données : PostgreSQL uniquement (depuis le 12/10/2026 ; SQLite n'est plus utilisé).
# Ne jamais remettre de ligne DB_ENGINE : GestiStock refuse de démarrer avec DB_ENGINE=sqlite.
DB_NAME=gestistock
DB_USER=gestistock
DB_PASSWORD=mot_de_passe_de_l_utilisateur_gestistock
DB_HOST=127.0.0.1
DB_PORT=5432
DJANGO_DEBUG=1

# Emails (11/10/2026) : le Responsable HBC est prévenu quand une réquisition attend son visa.
# DÉSACTIVÉS pour l'instant (11/10, 22 h 15) : mettre 1 pour les réactiver.
GESTISTOCK_EMAILS=0
# Le mot de passe d'application Gmail se règle avec outils\configurer-email.bat (jamais le mot de passe habituel).
# Sans mot de passe, les emails ne partent pas : ils sont enregistrés dans backend\emails-non-envoyes.
EMAIL_HOST_USER=adresse@gmail.com
EMAIL_HOST_PASSWORD=
# Destinataire temporaire (vide = les adresses des comptes Responsable HBC).
GESTISTOCK_EMAIL_TEMPORAIRE=adresse@gmail.com
# Adresse de l'application dans le lien de l'email (à changer lors de l'hébergement).
GESTISTOCK_ADRESSE=http://127.0.0.1:3000
